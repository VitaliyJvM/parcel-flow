      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (category) (rate(parcelflow_tracking_events_failed_total[$__rate_interval]))",
          "legendFormat": "{{category}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dead letters",
