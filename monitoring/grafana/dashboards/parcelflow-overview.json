    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "Records behind the head of the partition, from the Kafka client's own metrics. The single number that says whether ingest is keeping up; latency can look fine while lag grows.",
      "datasource": {
        "type": "prometheus",
        "uid": "parcelflow-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
