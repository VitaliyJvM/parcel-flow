{
  "uid": "parcelflow-overview",
  "title": "ParcelFlow \u2014 service overview",
  "description": "Event pipeline, backlog, API and runtime for the tracking service. Provisioned from monitoring/grafana/dashboards in the repository.",
  "tags": [
    "parcelflow"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Event pipeline",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Event throughput",
      "description": "Events per second entering and leaving the pipeline. received counts every entry including redeliveries; processed = applied + out of order + duplicate.",
      "datasource": {
        "type": "prometheus",
        "uid": "parcelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(parcelflow_tracking_events_received_total[$__rate_interval]))",
          "legendFormat": "received",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(parcelflow_tracking_events_processed_total[$__rate_interval]))",
          "legendFormat": "processed",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(parcelflow_tracking_events_applied_total[$__rate_interval]))",
          "legendFormat": "applied",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(parcelflow_tracking_events_failed_total[$__rate_interval]))",
          "legendFormat": "failed",
          "range": true,
          "refId": "D"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Event processing latency",
      "description": "Quantiles derived server-side from the histogram, so they stay meaningful across more than one instance. Spans the whole call including in-process optimistic-lock retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "parcelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(parcelflow_tracking_event_processing_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(parcelflow_tracking_event_processing_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(parcelflow_tracking_event_processing_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duplicates and out-of-order events",
      "description": "Neither is an error. Both are expected against a real carrier feed, and both are worth watching: a sudden climb in duplicates is a redelivery storm, and in out-of-order events a carrier backfilling scans.",
      "datasource": {
        "type": "prometheus",
        "uid": "parcelflow-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(parcelflow_tracking_events_duplicate_total[$__rate_interval]))",
          "legendFormat": "duplicate",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(parcelflow_tracking_events_out_of_order_total[$__rate_interval]))",
          "legendFormat": "out of order",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parcelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(parcelflow_tracking_events_optimistic_lock_conflicts_total[$__rate_interval]))",
          "legendFormat": "lock conflicts",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failures by category",
      "description": "The category comes from ProcessingErrorClassifier, the same classifier that decides whether the record is retried \u2014 so this panel and the retry policy cannot disagree.",
      "datasource": {
        "type": "prometheus",
        "uid": "parcelflow-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
