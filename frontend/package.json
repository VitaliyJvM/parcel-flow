{
  "name": "parcelflow-web",
  "version": "0.1.0",
  "description": "Angular frontend for the ParcelFlow tracking service (local, unauthenticated demo).",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint && tsc -p tsconfig.e2e.json && node scripts/check-icons.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\"",
    "api:generate": "openapi-typescript openapi/tracking-service.openapi.json --properties-required-by-default -o src/app/core/api/generated/tracking-service.ts",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "icons:check": "node scripts/check-icons.mjs",
    "icons:subset": "python3 scripts/subset-material-symbols.py"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@fontsource-variable/material-symbols-outlined": "5.3.9",
    "@fontsource/roboto": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
