{
  "components": {
    "schemas": {
      "AuthSessionResponse": {
        "description": "The browser session's authentication state",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser",
            "description": "The signed-in user; absent when not authenticated"
          }
        },
        "type": "object"
      },
      "CsrfToken": {
        "properties": {
          "headerName": {
            "type": "string"
          },
          "parameterName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CsrfTokenResponse": {
        "description": "A CSRF token and where to send it",
        "properties": {
          "headerName": {
            "example": "X-XSRF-TOKEN",
            "type": "string"
          },
          "parameterName": {
            "example": "_csrf",
            "type": "string"
          },
          "token": {
            "description": "Masked per response; any issued value stays valid for the session",
            "type": "string"
          }
        },
        "type": "object"
      },
      "FailedEventResponse": {
        "description": "A carrier event that could not be processed",
        "properties": {
          "errorCategory": {
            "enum": [
              "MALFORMED_PAYLOAD",
              "VALIDATION",
              "UNKNOWN_EVENT_TYPE",
              "CARRIER_MISMATCH",
              "UNSUPPORTED_CARRIER",
              "SHIPMENT_NOT_FOUND",
              "CONCURRENCY_CONFLICT",
              "INFRASTRUCTURE",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "errorMessage": {
            "description": "Exception message, truncated. No stack trace.",
            "type": "string"
          },
          "errorType": {
            "description": "Exception class name",
            "example": "ca.vm.parcelflow.tracking.InvalidCarrierEventException",
            "type": "string"
          },
          "eventId": {
            "description": "The carrier's event id, absent when the payload could not be parsed",
            "format": "uuid",
            "type": "string"
          },
          "failedEventId": {
            "format": "uuid",
            "type": "string"
          },
          "firstFailedAt": {
            "format": "date-time",
            "type": "string"
          },
          "lastFailedAt": {
            "format": "date-time",
            "type": "string"
          },
          "originalOffset": {
            "format": "int64",
            "type": "integer"
          },
          "originalPartition": {
            "format": "int32",
            "type": "integer"
          },
          "originalTopic": {
            "type": "string"
          },
          "retryCount": {
            "format": "int32",
            "type": "integer"
          },
          "retryableAutomatically": {
            "description": "Whether the automatic retry policy considers this worth re-delivering",
            "type": "boolean"
          },
          "retryableManually": {
            "description": "Whether POST .../retry will accept this event",
            "type": "boolean"
          },
          "shipmentId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "FAILED",
              "RETRYING",
              "RESOLVED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "FailedEventRetryResponse": {
        "description": "Result of reprocessing a failed event",
        "properties": {
          "detail": {
            "description": "Human-readable summary of the outcome",
            "type": "string"
          },
          "duplicate": {
            "description": "True when the event turned out to be already stored — still a success",
            "type": "boolean"
          },
          "failedEventId": {
            "format": "uuid",
            "type": "string"
          },
          "processingStatus": {
            "description": "How the event was recorded, when the retry succeeded",
            "enum": [
              "APPLIED",
              "SUPERSEDED"
            ],
            "type": "string"
          },
          "shipmentStatus": {
            "description": "The shipment's status after reprocessing, when the retry succeeded",
            "enum": [
              "LABEL_CREATED",
              "PICKED_UP",
              "IN_TRANSIT",
              "ARRIVED_AT_FACILITY",
              "OUT_FOR_DELIVERY",
              "DELAYED",
              "DELIVERY_ATTEMPTED",
              "DELIVERED"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "FAILED",
              "RETRYING",
              "RESOLVED"
            ],
            "type": "string"
          },
          "succeeded": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "NotificationResponse": {
        "description": "A notification record generated for a delivery milestone. Nothing is sent.",
        "properties": {
          "channel": {
            "enum": [
              "EMAIL"
            ],
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "notificationId": {
            "format": "uuid",
            "type": "string"
          },
          "notificationType": {
            "enum": [
              "PICKED_UP",
              "OUT_FOR_DELIVERY",
              "DELAYED",
              "DELIVERY_ATTEMPTED",
              "DELIVERED"
            ],
            "type": "string"
          },
          "sourceEventId": {
            "description": "The tracking event that caused this notification",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "PageResponseFailedEventResponse": {
        "description": "A page of results",
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/FailedEventResponse"
            },
            "type": "array"
          },
          "hasNext": {
            "type": "boolean"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageResponseNotificationResponse": {
        "description": "A page of results",
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/NotificationResponse"
            },
            "type": "array"
          },
          "hasNext": {
            "type": "boolean"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageResponseShipmentResponse": {
        "description": "A page of results",
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/ShipmentResponse"
            },
            "type": "array"
          },
          "hasNext": {
            "type": "boolean"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageResponseTrackingEventResponse": {
        "description": "A page of results",
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/TrackingEventResponse"
            },
            "type": "array"
          },
          "hasNext": {
            "type": "boolean"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "RFC 9457 problem document. Branch on `type`, not on `title` or `detail`. Problem-specific extension members (for example `carrierCode` and `trackingNumber` on shipment-not-found) appear at the top level.",
        "properties": {
          "detail": {
            "example": "No shipment found for carrier SWIFTPOST and tracking number SP-12345",
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Parameter or field name to message. Present on validation failures.",
            "type": "object"
          },
          "instance": {
            "example": "/api/shipments/lookup",
            "format": "uri",
            "type": "string"
          },
          "status": {
            "example": 404,
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "example": "Shipment not found",
            "type": "string"
          },
          "type": {
            "example": "https://parcelflow.example/problems/shipment-not-found",
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RegisterShipmentRequest": {
        "description": "Registers a parcel for tracking",
        "properties": {
          "carrierCode": {
            "enum": [
              "SWIFTPOST",
              "NORDEX",
              "PACIFICA",
              "METROLINK"
            ],
            "type": "string"
          },
          "customerId": {
            "description": "Opaque retailer-side customer reference. Never logged.",
            "example": "cust-9f13",
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "estimatedDeliveryDate": {
            "example": "2026-08-12",
            "format": "date",
            "type": "string"
          },
          "retailerId": {
            "example": "retailer-42",
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "trackingNumber": {
            "example": "SP100000000042",
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "carrierCode",
          "customerId",
          "retailerId",
          "trackingNumber"
        ],
        "type": "object"
      },
      "SessionUser": {
        "description": "The signed-in user",
        "properties": {
          "displayName": {
            "example": "Alex Alpha",
            "type": "string"
          },
          "retailerId": {
            "description": "The only retailer a RETAILER may act for, assigned in the identity provider. Absent for ADMIN, who may act for any retailer.",
            "example": "alpha-goods",
            "type": "string"
          },
          "role": {
            "enum": [
              "ADMIN",
              "RETAILER"
            ],
            "type": "string"
          },
          "subject": {
            "description": "Stable identifier at the identity provider (OIDC sub)",
            "type": "string"
          },
          "username": {
            "example": "retailer.alpha",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ShipmentResponse": {
        "description": "Current tracking state of a shipment",
        "properties": {
          "carrierCode": {
            "enum": [
              "SWIFTPOST",
              "NORDEX",
              "PACIFICA",
              "METROLINK"
            ],
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currentStatus": {
            "enum": [
              "LABEL_CREATED",
              "PICKED_UP",
              "IN_TRANSIT",
              "ARRIVED_AT_FACILITY",
              "OUT_FOR_DELIVERY",
              "DELAYED",
              "DELIVERY_ATTEMPTED",
              "DELIVERED"
            ],
            "type": "string"
          },
          "estimatedDeliveryDate": {
            "format": "date",
            "type": "string"
          },
          "lastEventTime": {
            "format": "date-time",
            "type": "string"
          },
          "retailerId": {
            "type": "string"
          },
          "shipmentId": {
            "format": "uuid",
            "type": "string"
          },
          "trackingNumber": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TrackingEventResponse": {
        "description": "A single carrier scan in a parcel's tracking history",
        "properties": {
          "carrierCode": {
            "enum": [
              "SWIFTPOST",
              "NORDEX",
              "PACIFICA",
              "METROLINK"
            ],
            "type": "string"
          },
          "carrierEventType": {
            "description": "The carrier's own event code, as received",
            "example": "SP_OFD",
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "eventId": {
            "format": "uuid",
            "type": "string"
          },
          "eventTime": {
            "description": "When the carrier observed the event (UTC)",
            "format": "date-time",
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "normalizedEventType": {
            "description": "ParcelFlow's normalized reading of the event",
            "enum": [
              "LABEL_CREATED",
              "PICKED_UP",
              "IN_TRANSIT",
              "ARRIVED_AT_FACILITY",
              "OUT_FOR_DELIVERY",
              "DELAYED",
              "DELIVERY_ATTEMPTED",
              "DELIVERED"
            ],
            "example": "OUT_FOR_DELIVERY",
            "type": "string"
          },
          "processingStatus": {
            "description": "Whether this event advanced the shipment status or was superseded",
            "enum": [
              "APPLIED",
              "SUPERSEDED"
            ],
            "type": "string"
          },
          "receivedAt": {
            "description": "When ParcelFlow ingested the event (UTC)",
            "format": "date-time",
            "type": "string"
          },
          "sequenceNumber": {
            "description": "The carrier's per-shipment ordering counter",
            "example": 5,
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "browserSession": {
        "description": "HttpOnly session cookie set by the OIDC login. Named `__Host-parcelflow-session` in production configurations.",
        "in": "cookie",
        "name": "PARCELFLOW_SESSION",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Shipment tracking and carrier event processing.\n\n**Authentication.** Every `/api/**` endpoint except `/api/auth/*` requires a browser session established by the OIDC login (`GET /oauth2/authorization/keycloak`). Unauthenticated calls get 401, forbidden ones 403, both as `application/problem+json`. State-changing requests also need the `X-XSRF-TOKEN` header carrying the session's CSRF token from `GET /api/auth/csrf`.\n\n**Retailer isolation.** A RETAILER sees only their own retailer's shipments; another retailer's shipment answers 404 exactly as a nonexistent one does. ADMIN sees every retailer and the `/api/admin` endpoints.\n\nParcelFlow is an independent portfolio and training project. It is not affiliated with or based on proprietary systems from any delivery carriers or ecommerce retailers. Carrier codes are fictional.",
    "license": {
      "name": "MIT"
    },
    "title": "ParcelFlow Tracking Service API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/failed-events": {
      "get": {
        "description": "Responses carry the exception type and message but never a stack trace or the original payload.",
        "operationId": "listFailedEvents",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "FAILED",
                "RETRYING",
                "RESOLVED"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseFailedEventResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List failed events, most recent failure first",
        "tags": [
          "Admin: failed events"
        ]
      }
    },
    "/api/admin/failed-events/{failedEventId}": {
      "get": {
        "operationId": "getFailedEvent",
        "parameters": [
          {
            "in": "path",
            "name": "failedEventId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FailedEventResponse"
                }
              }
            },
            "description": "No such failed event"
          }
        },
        "summary": "Get one failed event",
        "tags": [
          "Admin: failed events"
        ]
      }
    },
    "/api/admin/failed-events/{failedEventId}/retry": {
      "post": {
        "description": "Runs the event through the normal processing pipeline in-process and reports the real outcome, rather than republishing to Kafka and answering \"accepted\".\n\nRejected with 409 when the failure category can never succeed on retry (a malformed payload, a missing field), and when another retry already holds the record. Reprocessing is idempotent: an event that did eventually get stored comes back as a duplicate, not an error.",
        "operationId": "retryFailedEvent",
        "parameters": [
          {
            "in": "path",
            "name": "failedEventId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FailedEventRetryResponse"
                }
              }
            },
            "description": "Retry attempted; body reports the outcome"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FailedEventRetryResponse"
                }
              }
            },
            "description": "No such failed event"
          },
          "409": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FailedEventRetryResponse"
                }
              }
            },
            "description": "Not retryable, or a retry is already in progress"
          }
        },
        "summary": "Reprocess a failed event",
        "tags": [
          "Admin: failed events"
        ]
      }
    },
    "/api/auth/csrf": {
      "get": {
        "description": "Send it as the `X-XSRF-TOKEN` header of every state-changing request, or as the `_csrf` field of a form POST (logout). Every value issued stays valid until the session ends or the user logs in or out.",
        "operationId": "csrf",
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CsrfToken"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [],
        "summary": "Get the session's CSRF token",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/session": {
      "get": {
        "description": "Returns `authenticated: false` when there is no authenticated session. Never returns tokens. Restores the UI's state after a page reload.",
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [],
        "summary": "Describe the current browser session",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/retailers/{retailerId}/shipments": {
      "get": {
        "description": "A RETAILER may list only their own retailer id; ADMIN may list any.",
        "operationId": "listRetailerShipments",
        "parameters": [
          {
            "in": "path",
            "name": "retailerId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by current status",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "LABEL_CREATED",
                "PICKED_UP",
                "IN_TRANSIT",
                "ARRIVED_AT_FACILITY",
                "OUT_FOR_DELIVERY",
                "DELAYED",
                "DELIVERY_ATTEMPTED",
                "DELIVERED"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseShipmentResponse"
                }
              }
            },
            "description": "A page of shipments"
          },
          "403": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseShipmentResponse"
                }
              }
            },
            "description": "Not permitted to act for this retailer"
          }
        },
        "summary": "List a retailer's shipments, newest first",
        "tags": [
          "Retailers"
        ]
      }
    },
    "/api/shipments": {
      "post": {
        "operationId": "registerShipment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterShipmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            },
            "description": "Shipment registered"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A RETAILER may register shipments only under their own retailer id"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Tracking number already registered for this carrier. The pair is unique across all retailers. `existingShipmentAccessible` says whether the caller may open the existing shipment; nothing else about it is disclosed."
          }
        },
        "summary": "Register a shipment for tracking",
        "tags": [
          "Shipments"
        ]
      }
    },
    "/api/shipments/lookup": {
      "get": {
        "description": "Resolves the carrier-issued tracking number to the shipment registered under it. A tracking number is unique per carrier, not globally, so the carrier is required. Matching is exact: case-sensitive and not trimmed, the same comparison the duplicate-registration check uses. Read from PostgreSQL, not the cache.",
        "operationId": "lookupShipment",
        "parameters": [
          {
            "description": "Carrier that issued the tracking number",
            "example": "SWIFTPOST",
            "in": "query",
            "name": "carrierCode",
            "required": true,
            "schema": {
              "enum": [
                "SWIFTPOST",
                "NORDEX",
                "PACIFICA",
                "METROLINK"
              ],
              "type": "string"
            }
          },
          {
            "description": "Carrier-issued tracking number, matched exactly",
            "example": "SP100000000042",
            "in": "query",
            "name": "trackingNumber",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 0,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            },
            "description": "The matching shipment"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A parameter is missing, blank, too long, or not a known carrier code"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No shipment is registered for this carrier and tracking number, or it is not the caller's"
          }
        },
        "summary": "Find a shipment by carrier and tracking number",
        "tags": [
          "Shipments"
        ]
      }
    },
    "/api/shipments/{shipmentId}": {
      "get": {
        "description": "Served from a Redis cache that is evicted whenever an event advances the shipment, and expires on a TTL as a backstop. PostgreSQL remains the source of truth: if Redis is unavailable the response is identical, just slower.",
        "operationId": "getShipment",
        "parameters": [
          {
            "in": "path",
            "name": "shipmentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            },
            "description": "Current shipment state"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            },
            "description": "No such shipment, or not the caller's"
          }
        },
        "summary": "Get the current status of a shipment",
        "tags": [
          "Shipments"
        ]
      }
    },
    "/api/shipments/{shipmentId}/events": {
      "get": {
        "description": "Events are ordered by event time ascending, then by the carrier's sequence number. Superseded events — those that arrived too late to change the current status — are included: they are real observations and belong in the history.",
        "operationId": "getTrackingHistory",
        "parameters": [
          {
            "in": "path",
            "name": "shipmentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 50,
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseTrackingEventResponse"
                }
              }
            },
            "description": "A page of tracking events"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseTrackingEventResponse"
                }
              }
            },
            "description": "No such shipment, or not the caller's"
          }
        },
        "summary": "Get a parcel's tracking history",
        "tags": [
          "Tracking history"
        ]
      }
    },
    "/api/shipments/{shipmentId}/notifications": {
      "get": {
        "description": "Records only — ParcelFlow does not send email or SMS. Ordered oldest first by creation time, tie-broken by notification id so paging is deterministic when several notifications share a timestamp.",
        "operationId": "getNotifications",
        "parameters": [
          {
            "in": "path",
            "name": "shipmentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 50,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseNotificationResponse"
                }
              }
            },
            "description": "A page of notification records"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseNotificationResponse"
                }
              }
            },
            "description": "No such shipment, or not the caller's"
          }
        },
        "summary": "List the notification records generated for a parcel",
        "tags": [
          "Notifications"
        ]
      }
    }
  },
  "security": [
    {
      "browserSession": []
    }
  ],
