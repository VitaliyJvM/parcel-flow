# ParcelFlow local configuration — one file for everything a developer's machine needs.
#
#   ./scripts/init-local-secrets.sh   # creates .env from this file and generates the Keycloak secrets
#                                     # then fill in the SonarQube values if you run the analysis
#
# `.env` is git-ignored; this template is committed so the required variables are discoverable.
# Two things read it:
#
#   docker compose ...        automatically, for the variables it references below
#   ./scripts/run-sonar.sh    parsed, never sourced, and only for the SONAR_* keys
#
# A local `./gradlew :tracking-service:bootRun` reads neither, so export it first:
#
#   set -a && source .env && set +a
#
# A real deployment has no file like this: it injects the same variables from its secret store.


# -----------------------------------------------------------------------------
# Database
#
# These are not secrets — they are the throwaway PostgreSQL container that
# `docker compose up` starts on a laptop. They live here rather than in
# tracking-service/src/main/resources/application.yml because that file is packaged into the jar
# and the image, and would ship a credential with every build (SonarQube java:S6437).
#
# Compose falls back to these same defaults when there is no `.env` at all, so a fresh clone runs
# with no setup. The postgres container and the service read the same variables, so changing a
# value here changes it on both sides.
# -----------------------------------------------------------------------------

POSTGRES_DB=parcelflow
POSTGRES_USER=parcelflow
POSTGRES_PASSWORD=parcelflow

# What `bootRun` connects to when the infrastructure runs under Compose but the service does not.
# Inside Compose the host is `postgres`, and Compose sets these itself.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/parcelflow
SPRING_DATASOURCE_USERNAME=parcelflow
SPRING_DATASOURCE_PASSWORD=parcelflow


# -----------------------------------------------------------------------------
# Authentication — Keycloak and the tracking service's OIDC client
#
# Real secrets, even locally: they are why `docker compose` refuses to start until they are set.
# Do not type values here — generate random ones:
#
#   ./scripts/init-local-secrets.sh            # fills in whichever of these are empty
#   ./scripts/init-local-secrets.sh --print    # ...and shows the local login passwords
#
#   PARCELFLOW_OIDC_CLIENT_SECRET  confidential client secret, read by Keycloak (realm import) and
#                                  the tracking service (code exchange). Must match on both sides.
#   PARCELFLOW_ADMIN_PASSWORD      local ADMIN user `ops.admin`
#   PARCELFLOW_RETAILER_PASSWORD   local RETAILER users `retailer.alpha` (retailer alpha-goods),
#                                  `retailer.beta` (beta-supplies) and `retailer.unassigned` (no
#                                  retailer: login is refused, which is the point of that user)
#   KEYCLOAK_ADMIN_PASSWORD        Keycloak admin console, http://localhost:8180/admin, user `admin`
#
# Keycloak imports the realm only when its container is created, so after changing any value:
#   docker compose up -d --force-recreate keycloak tracking-service
#
# `./gradlew :tracking-service:bootRun` (Keycloak still in Compose) needs, in addition:
#   SPRING_PROFILES_ACTIVE=local   (non-Secure session cookie and no HTTPS redirect on localhost;
#                                   the issuer defaults to http://localhost:8180/realms/parcelflow)
# -----------------------------------------------------------------------------

PARCELFLOW_OIDC_CLIENT_SECRET=
PARCELFLOW_ADMIN_PASSWORD=
PARCELFLOW_RETAILER_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# Optional overrides.
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_PORT=8180


# -----------------------------------------------------------------------------
# SonarQube Cloud — ./scripts/run-sonar.sh
#
# Unlike the database values above, SONAR_TOKEN is a real credential. Treat it as a password: it
# is why `.env` is git-ignored, and why the script prints every other value but that one.
#
# Where each value comes from in SonarQube Cloud (https://sonarcloud.io):
#
#   SONAR_TOKEN         My Account > Security > Generate Tokens.
#   SONAR_PROJECT_KEY   Your project > Information (or Administration > Update Key).
#   SONAR_ORGANIZATION  The organization key in your organization's URL / Administration page.
#
# CI does not read this file. The runner gets SONAR_TOKEN from a GitHub Actions secret and
# SONAR_PROJECT_KEY / SONAR_ORGANIZATION from repository variables.
# -----------------------------------------------------------------------------

SONAR_TOKEN=
SONAR_PROJECT_KEY=
SONAR_ORGANIZATION=

# Optional. Only set this if you analyse against a self-hosted SonarQube Server instead of
# SonarQube Cloud. Leave it unset for Cloud, which the build already defaults to.
# SONAR_HOST_URL=
